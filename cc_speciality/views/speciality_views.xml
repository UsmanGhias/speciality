<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_speciality_speciality_tree" model="ir.ui.view">
        <field name="name">speciality.speciality.tree</field>
        <field name="model">speciality.speciality</field>
        <field name="arch" type="xml">
            <tree string="Specialities">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_speciality_speciality_form" model="ir.ui.view">
        <field name="name">speciality.speciality.form</field>
        <field name="model">speciality.speciality</field>
        <field name="arch" type="xml">
            <form string="Speciality">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2" placeholder="Detailed scope, qualification criteria, or certification guidelines..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_speciality_speciality_search" model="ir.ui.view">
        <field name="name">speciality.speciality.search</field>
        <field name="model">speciality.speciality</field>
        <field name="arch" type="xml">
            <search string="Search Specialities">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_speciality_speciality" model="ir.actions.act_window">
        <field name="name">Business Specialities</field>
        <field name="res_model">speciality.speciality</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_speciality_speciality_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your first business speciality
            </p>
            <p>
                Create and organize reusable business qualifications, skills, and industry specialities to classify your partners, consultants, and teams.
            </p>
        </field>
    </record>

    <!-- Menuitem -->
    <menuitem id="menu_speciality_root"
              name="Specialities"
              sequence="85"
              web_icon="cc_speciality,static/description/icon.png"/>

    <menuitem id="menu_speciality_speciality"
              name="All Specialities"
              parent="menu_speciality_root"
              action="action_speciality_speciality"
              sequence="10"/>

</odoo>
