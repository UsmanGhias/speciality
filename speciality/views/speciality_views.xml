<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_speciality_speciality_list" model="ir.ui.view">
        <field name="name">speciality.speciality.list</field>
        <field name="model">speciality.speciality</field>
        <field name="arch" type="xml">
            <list string="Specialities">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_speciality_speciality_form" model="ir.ui.view">
        <field name="name">speciality.speciality.form</field>
        <field name="model">speciality.speciality</field>
        <field name="arch" type="xml">
            <form string="Speciality">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_speciality_speciality_search" model="ir.ui.view">
        <field name="name">speciality.speciality.search</field>
        <field name="model">speciality.speciality</field>
        <field name="arch" type="xml">
            <search string="Search Specialities">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
                <separator/>
                <filter
                    string="Active"
                    name="active"
                    domain="[('active', '=', True)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Active Status"
                        name="group_active"
                        context="{'group_by': 'active'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_speciality_speciality" model="ir.actions.act_window">
        <field name="name">Specialities</field>
        <field name="res_model">speciality.speciality</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_speciality_speciality_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first speciality
            </p>
            <p>
                Define reusable business specialities with a unique code, sequence, and description.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_speciality_root"
        name="Specialities"
        sequence="90"
    />
    <menuitem
        id="menu_speciality_speciality"
        name="Specialities"
        parent="menu_speciality_root"
        action="action_speciality_speciality"
        sequence="10"
    />
</odoo>
